APP_NAME="Meridian Weather"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meridian_weather
DB_USERNAME=root
DB_PASSWORD=

# Generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256

# Free key at https://openweathermap.org/api
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Allow requests from the Vite dev server
FRONTEND_URL=http://localhost:5173

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
